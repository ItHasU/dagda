{
  // Design-system adherence lint (ROADMAP, slice 1).
  //
  // Derived from `_adherence.oxlintrc.json`, delivered inside the Claude
  // Design "Nocturne" bundle. Two departures from the file as delivered:
  //
  // - the bundle expresses its three checks as `no-restricted-syntax`
  //   selectors, a rule oxlint does not implement. They are reimplemented,
  //   regexes and messages untouched, in the JS plugin below;
  // - the bundle's two other rules (`react/forbid-elements` and
  //   `no-restricted-imports`) were delivered with empty lists — no-ops that
  //   only pulled in two plugins, so they are dropped.
  //
  // Everything oxlint enables by default is off: this configuration answers
  // one question only — does the code stay inside the design tokens.
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "jsPlugins": [
    "./packages/build/oxlint-adherence.mjs"
  ],
  "rules": {
    "adherence/design-system": "warn"
  },
  "ignorePatterns": [
    "**/.tsc-build/**",
    "**/dist/**"
  ],
  "overrides": [
    {
      // Known debt, not a waiver. The reason has changed now that the shell
      // is built, so it is restated rather than left standing: the login page
      // no longer waits for `dagda-ui.css` to exist — it exists. It waits for
      // that stylesheet to be reachable by an anonymous visitor, and today it
      // is not: `style-loader` injects the CSS from inside `main.js`, which
      // sits behind the authentication gate. There is no file to link to.
      //
      // Getting rid of this means emitting the stylesheet as its own file,
      // which means a build dependency (`mini-css-extract-plugin`) — and
      // FEATURES §0 says a dependency is proposed and approved, never added
      // along the way. So it stays, with its colours written as
      // `var(--token, #fallback)`, ready to become a link tag the day that
      // proposal is made.
      "files": [
        "packages/server/src/auth/login.page.ts"
      ],
      "rules": {
        "adherence/design-system": "off"
      }
    }
  ]
}
