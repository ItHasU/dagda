# Bootstrap configuration, read from the environment.
#
# Only what is needed to start the process belongs here: anything that can be
# stored in the database is a system parameter, not an environment variable
# (FEATURES §11.5). Copy this file to .env to run the bootstrap application.

# -- HTTP server --
PORT=3000
BASE_URL=http://localhost:3000

# -- Database --
# Matches the credentials of docker-compose.yml.
DB_URL=postgresql://dagda:dagda@localhost:5432/dagda

# -- Secrets (optional here) --
# Protects the secret system parameters at rest (FEATURES §11.5), and signs the
# session cookies. Only mandatory once the application declares a secret
# parameter, which the bootstrap application does not — but setting it makes the
# sessions survive a restart instead of logging everyone out.
#
# Deliberately empty: a key shipped in an example file is a key that ends up in
# production. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SECRET_KEY=

# -- Accounts --
# Local accounts are the only authentication mode (FEATURES §7): no external
# provider, no public sign-up. On an empty database the framework creates
# admin/admin and says so at startup — change it at once.
